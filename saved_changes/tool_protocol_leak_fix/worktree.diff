+def sanitize_tool_protocol_markup(text: str) -> str:
+    raw = str(text or "")
+    if not raw.strip():
+        return ""
+    cleaned = _TOOL_CALL_BLOCK_RE.sub("", raw)
+    cleaned = _TOOL_CALL_OPEN_RE.sub("", cleaned)
+    cleaned = _TOOL_CALL_CLOSE_RE.sub("", cleaned)
+    cleaned = re.sub(r"<tool[^>\n]*$", "", cleaned, flags=re.IGNORECASE)
+    cleaned = re.sub(r"</tool[^>\n]*$", "", cleaned, flags=re.IGNORECASE)
+    cleaned = re.sub(r"[ \t]+\n", "\n", cleaned)
+    cleaned = re.sub(r"\n{3,}", "\n\n", cleaned)
+    cleaned = re.sub(r"[ \t]{2,}", " ", cleaned)
+    return cleaned.strip()
+
