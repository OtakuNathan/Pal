+@dataclass
+class _ToolProtocolStreamStripper:
+    inside_block: bool = False
+    buffer: str = ""
+
+    def consume(self, chunk: str) -> str:
+        if not chunk:
+            return ""
+        self.buffer += chunk
+        emitted: list[str] = []
+        open_marker = "<tool_call"
+        close_marker = "</tool_call>"
+        min_open_tail = max(len(open_marker) - 1, 0)
+        min_close_tail = max(len(close_marker) - 1, 0)
+        while self.buffer:
+            if self.inside_block:
+                close_index = self._find_case_insensitive(self.buffer, close_marker)
+                if close_index < 0:
+                    if len(self.buffer) > min_close_tail:
+                        self.buffer = self.buffer[-min_close_tail:]
+                    break
+                self.buffer = self.buffer[close_index + len(close_marker) :]
+                self.inside_block = False
+                continue
+            open_index = self._find_case_insensitive(self.buffer, open_marker)
+            if open_index < 0:
+                if len(self.buffer) > min_open_tail:
+                    emit = self.buffer[:-min_open_tail] if min_open_tail else self.buffer
+                    if emit:
+                        emitted.append(emit)
+                    self.buffer = self.buffer[-min_open_tail:] if min_open_tail else ""
+                break
+            prefix = self.buffer[:open_index]
+            if prefix:
+                emitted.append(prefix)
+            self.buffer = self.buffer[open_index:]
+            close_bracket = self.buffer.find(">")
+            if close_bracket < 0:
+                if len(self.buffer) > min_open_tail:
+                    self.buffer = self.buffer[-min_open_tail:]
+                break
+            self.buffer = self.buffer[close_bracket + 1 :]
+            self.inside_block = True
+        return "".join(emitted)
+
+    def flush(self) -> str:
+        if self.inside_block:
+            self.buffer = ""
+            self.inside_block = False
+            return ""
+        output = sanitize_tool_protocol_markup(self.buffer)
+        self.buffer = ""
+        return output
+
+    @staticmethod
+    def _find_case_insensitive(text: str, pattern: str) -> int:
+        return text.lower().find(pattern.lower())
 
 
