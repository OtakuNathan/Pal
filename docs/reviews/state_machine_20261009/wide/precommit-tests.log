                assert order == ['execution', 'execution receipt', 'submit']
                assert len([ref for ref in workspace['review_tool_evidence_refs'] if ref['call_id'] == 'direct']) == 1
            finally:
                runtime.base_runtime.runtime.shutdown()
                base.shutdown()
    
