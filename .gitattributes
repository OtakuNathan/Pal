# Normalize line endings: text files are stored as LF.
# Python sources are forced to LF regardless of platform (eol=lf),
# so editors/IDEs on any OS never reintroduce CRLF into these files.
* text=auto
*.py text eol=lf

# Preserve captured audit output, including pytest's traceback whitespace.
docs/reviews/state_machine_20261009/**/*.log -text -whitespace
