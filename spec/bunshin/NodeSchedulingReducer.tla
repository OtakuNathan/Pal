NodeRunnable(state, ready, fenced, slot) ==
    \E row \in NodeSchedulingDecisions :
        row[1] = state /\ row[2] = ready /\ row[3] = fenced /\ row[4] = slot

NodeSchedulingSafety ==
    \A row \in NodeSchedulingDecisions :
       /\ ((row[4] = "producer") <=> (row[2] /\ ~row[3] /\ row[1] \in {"ProducerReady", "RepairReady"}))
       /\ ((row[4] = "checker") <=> (row[2] /\ ~row[3] /\ row[1] = "CheckerReady"))
       /\ row[4] \in {"producer", "checker", "none"}
       /\ row[5] = (~row[3] /\ (row[4] # "none" \/ row[1] \in {"Producing", "Checking"}))
